# Set automatically when a Vercel Blob store is connected to this project.
BLOB_READ_WRITE_TOKEN=

# Secret for viewing assessment requests at /api/requests?key=...
# Generate one and add it in the Vercel project environment variables.
# Do not commit the real value.
SIGNUPS_VIEW_KEY=

# Speed-to-lead voice call (Retell). Leave unset to disable calls; the form still works.
RETELL_API_KEY=
RETELL_FROM_NUMBER=+61XXXXXXXXX
RETELL_AGENT_ID=agent_370af1a21b8aa02e9e07432fb7
# Optional: call window (defaults 8 to 20, Australia/Sydney)
CALL_TIMEZONE=Australia/Sydney
CALL_HOUR_START=8
CALL_HOUR_END=20
